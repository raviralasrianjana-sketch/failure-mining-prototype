# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml to GitHub -- it's already listed in
# .gitignore for you.
#
# Email/password sign-up and login work with zero setup, without any of
# this file. It's only needed for the optional AI Assistant chatbot below.

# ---------------------------------------------------------------------------
# 🤖 Failure Mining AI Assistant (optional) -- Google Gemini API config.
# Without this, the app still works fully; the chatbot just shows a
# friendly "not configured" message instead of answering.
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-1.5-flash"
